		async function handleShare() {
		const movieName = '@ViewBag.MovieName';
		const shareUrl = window.location.href;

		if (navigator.share) {
			try {
				await navigator.share({
					title: movieName,
					text: `${movieName} filmini izle!`,
					url: shareUrl
				});
			} catch (err) {
				console.log('Paylaşım iptal edildi');
			}
		} else {
			navigator.clipboard.writeText(shareUrl);
			alert('Link kopyalandı!');
		}
	}

	// ---- OYNATMA AYARLARINI UYGULA (localStorage) ----
	function applyPlaybackSettings(player) {
		const quality  = localStorage.getItem('pref_quality')  ?? 'auto';
		const autoplay = localStorage.getItem('pref_autoplay') ?? 'true';
		const audio    = localStorage.getItem('pref_audio')    ?? 'en';
		const subtitle = localStorage.getItem('pref_subtitle') ?? 'tr';

		// 1. Oynatma Hızı / Kalite göstergesi (HTML5 video kaliteyi doğrudan desteklemez,
		//    ama kullanıcıya bilgi verebiliriz)
		const qualityLabels = { auto: 'Otomatik', '4k': '4K', '1080p': '1080p', '720p': '720p' };
		console.log('[Ayarlar] Kalite tercihi:', qualityLabels[quality] ?? quality);

		// 2. Autoplay ayarı — bölüm bitince tekrar oynat
		if (autoplay === 'true') {
			player.addEventListener('ended', function () {
				// Sonraki bölüm linki varsa oraya git, yoksa sessiz kal
				const nextBtn = document.querySelector('[data-next-episode]');
				if (nextBtn) nextBtn.click();
			});
		}

		// 3. Ses dili — video içinde birden fazla audio track varsa uygula
		player.addEventListener('loadedmetadata', function () {
			if (player.audioTracks && player.audioTracks.length > 1) {
				for (let i = 0; i < player.audioTracks.length; i++) {
					const track = player.audioTracks[i];
					track.enabled = (track.language === audio);
				}
			}

			// 4. Altyazı — video içinde text track varsa uygula
			if (player.textTracks && player.textTracks.length > 0) {
				for (let i = 0; i < player.textTracks.length; i++) {
					const track = player.textTracks[i];
					if (subtitle === 'off') {
						track.mode = 'hidden';
					} else {
						track.mode = (track.language === subtitle) ? 'showing' : 'hidden';
					}
				}
			}
		});

		// 5. Kullanıcıya mevcut tercihleri bildir (KALDIRILDI)
		// showPlaybackInfoBadge(...)
	}

	function handleSubscribe(btn) {
		const publisherId = document.getElementById("publisherId").value;
		const movieId = document.getElementById("movieId").value;
		
		if (!publisherId) {
			if (typeof showToast === "function") showToast("Yayıncı bilgisi bulunamadı.", "info");
			return;
		}

		fetch('/Movie/Subscription', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json'
			},
			body: JSON.stringify({ 
				ChannelId: parseInt(publisherId),
				MovieID: movieId
			})
		})
		.then(response => response.json())
		.then(data => {
			if (data.success) {
				document.getElementById("btnSubscribe").classList.add("d-none");
				const subGroup = document.getElementById("subscriptionGroup");
				subGroup.classList.remove("d-none");

				// Bell ringing micro-animation on subscribe
				const bellBtn = document.getElementById("btnBellToggle");
				if (bellBtn) {
					bellBtn.classList.add("bell-ringing");
					setTimeout(() => bellBtn.classList.remove("bell-ringing"), 700);
				}

				if (typeof showToast === "function") {
					showToast("Kanala abone olundu! Tüm bildirimler açık 🔔", "success");
				}
			} else {
				if (typeof showToast === "function") {
					showToast(data.message || "Abonelik işlemi başarısız oldu.", "info");
				} else {
					alert(data.message || "Abonelik işlemi başarısız oldu.");
				}
			}
		})
		.catch(error => {
			console.error('Error:', error);
			if (typeof showToast === "function") showToast("Bir hata oluştu.", "info");
		});
	}

	function toggleBellDropdown(e) {
		e.stopPropagation();
		const menu = document.getElementById("bellDropdownMenu");
		if (menu) menu.classList.toggle("show");
	}

	function selectBellOption(opt) {
		const menu = document.getElementById("bellDropdownMenu");
		if (menu) menu.classList.remove("show");

		const optAll = document.getElementById("optBellAll");
		const optNone = document.getElementById("optBellNone");
		const bellBtn = document.getElementById("btnBellToggle");
		const iconHolder = document.getElementById("bellIconHolder");

		if (opt === 'all') {
			if (optAll) optAll.classList.add("selected");
			if (optNone) optNone.classList.remove("selected");
			if (bellBtn) {
				bellBtn.classList.add("active");
				bellBtn.classList.add("bell-ringing");
				setTimeout(() => bellBtn.classList.remove("bell-ringing"), 600);
			}
			if (iconHolder) {
				iconHolder.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>';
			}
			if (typeof showToast === "function") showToast("Bu kanal için tüm bildirimler açık 🔔", "success");
		} else {
			if (optAll) optAll.classList.remove("selected");
			if (optNone) optNone.classList.add("selected");
			if (bellBtn) bellBtn.classList.remove("active");
			if (iconHolder) {
				iconHolder.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';
			}
			if (typeof showToast === "function") showToast("Bu kanal için bildirimler kapatıldı 🔕", "info");
		}
	}

	window.addEventListener('click', function(e) {
		const menu = document.getElementById("bellDropdownMenu");
		if (menu && menu.classList.contains("show")) {
			menu.classList.remove("show");
		}
	});

	function handleUnsubscribe(btn) {
		document.getElementById('customUnsubscribeModal').style.display = 'flex';
	}

	function closeUnsubscribeModal() {
		document.getElementById('customUnsubscribeModal').style.display = 'none';
	}

	function confirmUnsubscribe() {
		const publisherId = document.getElementById("publisherId").value;
		
		if (!publisherId) {
			if (typeof showToast === "function") showToast("Yayıncı bilgisi bulunamadı.", "info");
			return;
		}

		fetch('/Movie/Unsubscription', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json'
			},
			body: publisherId
		})
		.then(response => response.json())
		.then(data => {
			if (data.success) {
				closeUnsubscribeModal();

				document.getElementById("subscriptionGroup").classList.add("d-none");
				document.getElementById("btnSubscribe").classList.remove("d-none");

				if (typeof showToast === "function") {
					showToast("Abonelikten çıkıldı.", "info");
				}
			} else {
				if (typeof showToast === "function") {
					showToast(data.message || "Abonelikten çıkma işlemi başarısız oldu.", "info");
				} else {
					alert(data.message || "Abonelikten çıkma işlemi başarısız oldu.");
				}
			}
		})
		.catch(error => {
			console.error('Error:', error);
			if (typeof showToast === "function") showToast("Bir hata oluştu.", "info");
		});
	}

