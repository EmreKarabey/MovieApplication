@using Microsoft.AspNetCore.Http
@{
	ViewData["Title"] = "Home Page";
	Layout = "_Layout";
}
<!-- TOPBAR -->
<div class="topbar">
	<div class="search-wrap">
		<span class="search-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
		<input class="search-input" id="homeSearchInput" placeholder="Film, dizi, yönetmen ara..." />
	</div>

	<div class="topbar-actions">
		@if (ViewBag.Role != null && ViewBag.Role == true)
		{
			<a href="/Movie/Publish" class="btn-ghost" style="background-color: var(--accent); color: #111; padding: 8px 16px; border-radius: 8px; font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(232, 184, 75, 0.3);">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect><line x1="8.5" y1="9" x2="8.5" y2="15"></line><line x1="5.5" y1="12" x2="11.5" y2="12"></line></svg> Yayınla
			</a>
		}
		<div class="icon-btn" id="notifBell">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
			<div class="notif-dot" style="display:none;"></div>
		</div>
		<div class="icon-btn dark-mode-btn" id="darkModeBtn" onclick="toggleDarkMode()" title="Karanlık/Aydınlık mod">
			<span class="dm-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg></span>
		</div>
	</div>
</div>

<!-- HERO -->
<div class="hero">
	<div class="hero-bg"></div>
	<div class="hero-gradient"></div>
	<div class="hero-gradient-bottom"></div>

	<!-- Film strip placeholder -->
	<div class="hero-film-strip">
		<div class="hero-film-img" style="background: linear-gradient(135deg,#1a0a0a,#2d1515);"></div>
		<div class="hero-film-img" style="background: linear-gradient(135deg,#0a0a1a,#151530);"></div>
		<div class="hero-film-img" style="background: linear-gradient(135deg,#0a1a0a,#153015);"></div>
		<div class="hero-film-img" style="background: linear-gradient(135deg,#1a150a,#302515);"></div>
		<div class="hero-film-img" style="background: linear-gradient(135deg,#150a1a,#250d30);"></div>
	</div>

	@await Component.InvokeAsync("_MovieOfTheWeekComponent")

</div>

<!-- CONTENT -->
<div class="content">
	@await Component.InvokeAsync("_CategoryListComponent")
	@await Component.InvokeAsync("_CategoryFilteringComponent", new { CategoryName = ViewBag.CategoryName })
	@await Component.InvokeAsync("_Editor_sChoiceComponent")

	<div class="section-header">
		<div class="section-title">Top <span>10</span> Bu Hafta</div>
		<button class="see-all">Tümünü Gör →</button>
	</div>
	<div class="top10-list" id="top10List"></div>

	<div id="loadingIndicator" style="display:none; text-align:center; padding: 20px; color: #fff;">
		<span style="font-size: 24px;">⏳</span> Yükleniyor...
	</div>

</div> 

<script>

	let currentPage = 0;
	let isLoading = false;
	let hasMore = true;
	let categoryName = '@Html.Raw(ViewBag.CategoryName ?? "")';

	let scrollTimeout;
	window.addEventListener('scroll', () => {
		if (scrollTimeout) return;
		scrollTimeout = setTimeout(() => {
			if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 150) {
				if (searchMode) {
					if (searchHasMore) loadSearch(false);
				} else {
					if (!isLoading && hasMore) loadMore();
				}
			}
			scrollTimeout = null;
		}, 100);
	});

	window.getMoviesUrl = function(cat, page) {
		const catParam = encodeURIComponent(cat || "");
		return `/Home/LoadMoreMovies?categoryName=${catParam}&pageIndex=${page}`;
	};

	async function loadMore() {
		isLoading = true;
		document.getElementById('loadingIndicator').style.display = 'block';
		currentPage++;
		
		try {
			const response = await fetch(window.getMoviesUrl(categoryName, currentPage));
			if (!response.ok) throw new Error("API hatası");
			
			const html = await response.text();
			const parser = new DOMParser();
			const doc = parser.parseFromString(html, 'text/html');
			
			const newCards = doc.querySelectorAll('.movie-grid > .movie-card');
			
			if (newCards.length === 0 || newCards.length < 10) {
				hasMore = false;
			}

			if (newCards.length > 0) {
				const container = document.querySelector('.movie-grid');
				if(container) {
					newCards.forEach(card => {
						container.appendChild(card);
						const favBtn = card.querySelector('.favorite-btn');
						if(favBtn && favBtn.dataset.movieId) checkIfFavorite(favBtn.dataset.movieId);
						const saveBtn = card.querySelector('.save-btn');
						if(saveBtn && saveBtn.dataset.movieId) checkIfSaved(saveBtn.dataset.movieId);
					});
				}
			}
		} catch (err) {
			console.error("Filmler yüklenirken hata: ", err);
		} finally {
			isLoading = false;
			document.getElementById('loadingIndicator').style.display = 'none';
		}
	}

	// ── ARAMA MANTIĞI ──
	let searchMode = false;
	let searchQuery = '';
	let searchPage = 0;
	let searchHasMore = true;
	let searchDebounceTimer = null;

	const searchInput = document.getElementById('homeSearchInput');

	if (searchInput) {
		searchInput.addEventListener('input', function () {
			const query = this.value.trim();
			clearTimeout(searchDebounceTimer);

			if (!query) {
				clearSearch();
				return;
			}

			searchDebounceTimer = setTimeout(() => {
				startSearch(query);
			}, 400);
		});
	}

	async function startSearch(query) {
		searchQuery = query;
		searchPage = 0;
		searchHasMore = true;
		searchMode = true;

		// Diğer bölümleri gizle
		const hero = document.querySelector('.hero');
		if(hero) hero.style.display = 'none';
		
		const sectionHeaders = document.querySelectorAll('.section-header');
		sectionHeaders.forEach(el => el.style.display = 'none');
		
		const featuredRow = document.querySelector('.featured-row');
		if(featuredRow) featuredRow.style.display = 'none';
		
		const top10List = document.querySelector('.top10-list');
		if(top10List) top10List.style.display = 'none';
		
		const catList = document.querySelector('.category-list');
		if(catList) catList.style.display = 'none';

		// Grid'i bul ve yükleniyor yaz
		let grid = document.querySelector('.content .movie-grid');
		if(grid) {
			grid.innerHTML = '<div style="text-align:center;padding:40px;color:var(--muted);width:100%;">⏳ Aranıyor...</div>';
		}
		await loadSearch(true);
	}

	async function loadSearch(replace = false) {
		if (!searchHasMore) return;

		try {
			const url = `/Movie/Search?s=${encodeURIComponent(searchQuery)}&pageIndex=${searchPage}`;
			const response = await fetch(url);
			if (!response.ok) throw new Error('Arama başarısız');
			const html = await response.text();

			let grid = document.querySelector('.content .movie-grid');
			if(!grid) return;

			if (replace) {
				grid.outerHTML = html;
			} else {
				const parser = new DOMParser();
				const doc = parser.parseFromString(html, 'text/html');
				const newCards = doc.querySelectorAll('.movie-grid > .movie-card');
				
				if (newCards.length === 0) { 
					searchHasMore = false; 
					return; 
				}

				grid = document.querySelector('.content .movie-grid');
				if(grid) {
					newCards.forEach(card => {
						grid.appendChild(card);
						const favBtn = card.querySelector('.favorite-btn');
						if(favBtn && favBtn.dataset.movieId) checkIfFavorite(favBtn.dataset.movieId);
						const saveBtn = card.querySelector('.save-btn');
						if(saveBtn && saveBtn.dataset.movieId) checkIfSaved(saveBtn.dataset.movieId);
					});
				}
			}

			const cardCount = (html.match(/movie-card/g) || []).length;
			if (cardCount < 10) searchHasMore = false;
			searchPage++;

		} catch (err) {
			console.error('Arama hatası:', err);
		}
	}

	function clearSearch() {
		searchMode = false; 
		searchQuery = ''; 
		searchPage = 0; 
		searchHasMore = true;

		// Diğer bölümleri göster
		const hero = document.querySelector('.hero');
		if(hero) hero.style.display = '';
		
		const sectionHeaders = document.querySelectorAll('.section-header');
		sectionHeaders.forEach(el => el.style.display = '');
		
		const featuredRow = document.querySelector('.featured-row');
		if(featuredRow) featuredRow.style.display = '';
		
		const top10List = document.querySelector('.top10-list');
		if(top10List) top10List.style.display = '';
		
		const catList = document.querySelector('.category-list');
		if(catList) catList.style.display = '';

		let grid = document.querySelector('.content .movie-grid');
		if(grid) grid.innerHTML = '';
		
		currentPage = -1;
		hasMore = true;
		loadMore();
	}
</script>
