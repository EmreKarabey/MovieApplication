@model PaginateList<SavedMovieListDto>
@{
	ViewData["Title"] = "Kaydedilenler";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	.page-header {
		padding: 32px 32px 0;
	}

	.page-title {
		font-family: 'DM Serif Display', serif;
		font-size: 32px;
		margin-bottom: 6px;
	}

		.page-title span {
			color: var(--accent);
		}

	.page-sub {
		font-size: 13px;
		color: var(--muted);
		margin-bottom: 0;
	}

	.empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 80px 20px;
		text-align: center;
		gap: 12px;
	}

	.empty-icon {
		font-size: 48px;
		opacity: 0.3;
	}

	.empty-title {
		font-family: 'DM Serif Display', serif;
		font-size: 22px;
	}

	.empty-desc {
		font-size: 13px;
		color: var(--muted);
	}

	/* Arama durumu badge */
	.search-status {
		display: none;
		align-items: center;
		gap: 8px;
		padding: 8px 16px;
		background: rgba(232,184,75,0.1);
		border: 1px solid rgba(232,184,75,0.25);
		border-radius: 8px;
		font-size: 12px;
		color: var(--accent);
		margin: 0 32px 0;
		width: fit-content;
	}

	.search-status.visible {
		display: flex;
	}

	.search-status-clear {
		background: none;
		border: none;
		color: var(--muted);
		cursor: pointer;
		font-size: 14px;
		padding: 0 2px;
		transition: color 0.2s;
	}

	.search-status-clear:hover {
		color: var(--accent2);
	}

	@@media (max-width: 768px) {
		.page-header {
			padding: 20px 16px 0;
		}

		.page-title {
			font-size: 24px;
		}

		.search-status {
			margin: 0 16px 10px;
		}
	}
</style>

<div class="topbar">
	<div class="search-wrap" id="savedSearchWrap">
		<span class="search-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
		<input class="search-input" id="savedSearchInput" placeholder="Kaydedilenlerde ara..." autocomplete="off">
	</div>
	<div class="topbar-actions">
		<div class="icon-btn" id="notifBell">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
			<div class="notif-dot" style="display:none;"></div>
		</div>
		<div class="icon-btn dark-mode-btn" id="darkModeBtn" onclick="toggleDarkMode()" title="Karanlık/Aydınlık mod">
			<span class="dm-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg></span>
		</div>
	</div>
</div>

<div class="page-header">
	<div class="page-title">Kaydedilen <span>Filmler</span></div>
	<div class="page-sub" id="savedSubTitle">@Model.Items.Count() film kaydedildi</div>
</div>

<!-- Arama modu bilgi bandı -->
<div class="search-status" id="savedSearchStatus">
	<span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
	<span id="savedSearchStatusText"></span>
	<button class="search-status-clear" onclick="clearSavedSearch()" title="Aramayı temizle">✕</button>
</div>

<div class="content">
	@await Component.InvokeAsync("_SavedCategoryListComponent")
	<div id="savedMovieContainer">
		@await Component.InvokeAsync("_SavedCategoryFilteringComponent", new { CategoryName = ViewBag.SCategoryName })
	</div>

	<div id="loadingIndicator" style="display:none; text-align:center; padding: 20px; color: var(--muted);">
		<span style="font-size: 24px;">⏳</span> Yükleniyor...
	</div>
</div>

<script>
	let userid = `@ViewBag.UserId`;
	let currentPage = 0;
	let isLoading = false;
	let hasMore = true;
	let categoryName = '@Html.Raw(ViewBag.SCategoryName ?? "")';

	// ── ARAMA DEĞİŞKENLERİ ──
	let searchMode = false;
	let searchQuery = '';
	let searchPage = 0;
	let searchHasMore = true;
	let searchDebounceTimer = null;

	// ── ELEMENTLER ──
	const savedSearchInput = document.getElementById('savedSearchInput');
	const savedSearchStatus = document.getElementById('savedSearchStatus');
	const savedSearchStatusText = document.getElementById('savedSearchStatusText');
	const savedSubTitle = document.getElementById('savedSubTitle');
	const savedMovieContainer = document.getElementById('savedMovieContainer');

	// ── INPUT LISTENER ──
	savedSearchInput.addEventListener('input', function () {
		const query = this.value.trim();
		clearTimeout(searchDebounceTimer);

		if (!query) {
			clearSavedSearch();
			return;
		}

		searchDebounceTimer = setTimeout(() => {
			startSavedSearch(query);
		}, 400);
	});

	async function startSavedSearch(query) {
		searchQuery = query;
		searchPage = 0;
		searchHasMore = true;
		searchMode = true;

		savedMovieContainer.innerHTML = '<div style="text-align:center;padding:40px;color:var(--muted);font-size:13px;">⏳ Aranıyor...</div>';
		savedSearchStatus.classList.add('visible');
		savedSearchStatusText.textContent = `"${query}" için sonuçlar`;

		await loadSearchResults(true);
	}

	async function loadSearchResults(replace = false) {
		if (isLoading || !searchHasMore) return;
		isLoading = true;

		const loadingEl = document.getElementById('loadingIndicator');
		if (loadingEl) loadingEl.style.display = 'block';

		try {
			const url = `/SavedMovie/Search?s=${encodeURIComponent(searchQuery)}&pageIndex=${searchPage}`;
			const response = await fetch(url);
			if (!response.ok) throw new Error('Arama başarısız');

			const html = await response.text();
			const parser = new DOMParser();
			const doc = parser.parseFromString(html, 'text/html');
			const newCards = doc.querySelectorAll('.movie-grid > .movie-card');

			if (newCards.length === 0 || newCards.length < 10) {
				searchHasMore = false;
			}

			if (replace) {
				if (newCards.length === 0) {
					savedMovieContainer.innerHTML = `
						<div class="empty">
							<div class="empty-icon">🔍</div>
							<div class="empty-title">Sonuç bulunamadı</div>
							<div class="empty-desc">"${searchQuery}" için kaydedilenlerinizde film yok.</div>
						</div>`;
					savedSubTitle.textContent = '0 sonuç bulundu';
					return;
				}
				savedMovieContainer.innerHTML = '<div class="movie-grid" id="searchGrid"></div>';
			}

			let grid = savedMovieContainer.querySelector('.movie-grid');
			if (!grid) {
				grid = document.createElement('div');
				grid.className = 'movie-grid';
				grid.id = 'searchGrid';
				savedMovieContainer.appendChild(grid);
			}

			newCards.forEach(card => {
				grid.appendChild(card);
				const favBtn = card.querySelector('.favorite-btn');
				if (favBtn && favBtn.dataset.movieId) checkIfFavorite(favBtn.dataset.movieId);
				const saveBtn = card.querySelector('.save-btn');
				if (saveBtn && saveBtn.dataset.movieId) checkIfSaved(saveBtn.dataset.movieId);
			});

			searchPage++;

			const total = savedMovieContainer.querySelectorAll('.movie-card').length;
			savedSubTitle.textContent = `${total}+ sonuç "${searchQuery}" için`;

		} catch (err) {
			console.error('Arama hatası:', err);
			showToast('Arama sırasında hata oluştu.', 'info');
		} finally {
			isLoading = false;
			const loadingEl = document.getElementById('loadingIndicator');
			if (loadingEl) loadingEl.style.display = 'none';
		}
	}

	function clearSavedSearch() {
		searchMode = false;
		searchQuery = '';
		searchPage = 0;
		searchHasMore = true;
		savedSearchInput.value = '';
		savedSearchStatus.classList.remove('visible');
		savedSubTitle.textContent = '@Model.Items.Count() film kaydedildi';

		// Orijinal listeyi geri yükle
		savedMovieContainer.innerHTML = '';
		fetch(`/SavedMovie/SLoadMoreMovies?categoryName=&pageIndex=0`)
			.then(r => r.text())
			.then(html => {
				savedMovieContainer.innerHTML = html;
				savedMovieContainer.querySelectorAll('.movie-card').forEach(card => {
					const favBtn = card.querySelector('.favorite-btn');
					if (favBtn && favBtn.dataset.movieId) checkIfFavorite(favBtn.dataset.movieId);
					const saveBtn = card.querySelector('.save-btn');
					if (saveBtn && saveBtn.dataset.movieId) checkIfSaved(saveBtn.dataset.movieId);
				});
			})
			.catch(err => console.error('Liste yüklenemedi:', err));
	}

	// ── SCROLL ──
	let scrollTimeout;
	window.addEventListener('scroll', () => {
		if (scrollTimeout) return;
		scrollTimeout = setTimeout(() => {
			if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 150) {
				if (!isLoading) {
					if (searchMode && searchHasMore) {
						loadSearchResults(false);
					} else if (!searchMode && hasMore) {
						loadMore();
					}
				}
			}
			scrollTimeout = null;
		}, 100);
	});

	window.getMoviesUrl = function(cat, page) {
		const catParam = encodeURIComponent(cat || '');
		return `/SavedMovie/SLoadMoreMovies?categoryName=${catParam}&pageIndex=${page}`;
	};

	async function loadMore() {
		isLoading = true;
		document.getElementById('loadingIndicator').style.display = 'block';
		currentPage++;

		try {
			const response = await fetch(window.getMoviesUrl(categoryName, currentPage));
			if (!response.ok) throw new Error('API hatası');

			const html = await response.text();
			const parser = new DOMParser();
			const doc = parser.parseFromString(html, 'text/html');
			const newCards = doc.querySelectorAll('.movie-grid > .movie-card');

			if (newCards.length === 0 || newCards.length < 10) {
				hasMore = false;
			}

			if (newCards.length > 0) {
				const container = document.querySelector('.movie-grid');
				if (container) {
					newCards.forEach(card => {
						container.appendChild(card);
						const favBtn = card.querySelector('.favorite-btn');
						if (favBtn && favBtn.dataset.movieId) checkIfFavorite(favBtn.dataset.movieId);
						const saveBtn = card.querySelector('.save-btn');
						if (saveBtn && saveBtn.dataset.movieId) checkIfSaved(saveBtn.dataset.movieId);
					});
				}
			}
		} catch (err) {
			console.error('Filmler yüklenirken hata: ', err);
		} finally {
			isLoading = false;
			document.getElementById('loadingIndicator').style.display = 'none';
		}
	}
</script>
