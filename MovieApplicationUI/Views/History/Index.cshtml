			const html = await response.text();

			if (replace) {
				if (html.trim().length === 0) {
					likedListEl.innerHTML = `
						<div style="text-align:center;padding:60px 20px;color:var(--muted);">
							<div style="font-size:48px;margin-bottom:12px;">🔍</div>
							<div style="font-size:16px;font-weight:600;color:var(--text);">Sonuç bulunamadı</div>
							<div style="font-size:13px;margin-top:6px;">"${lSearchQuery}" için beğenilenlerinizde film yok.</div>
						</div>`;
					lSearchHasMore = false; return;
				}
				likedListEl.innerHTML = html;
			} else {
				if (html.trim().length === 0) { lSearchHasMore = false; return; }
				likedListEl.insertAdjacentHTML('beforeend', html);
			}

			const cardCount = (html.match(/history-card/g) || []).length;
			if (cardCount < 10) lSearchHasMore = false;
			lSearchPage++;

		} catch (err) {
			console.error('Arama hatası:', err);
			showToast('Arama sırasında hata oluştu.', 'info');
		}
	}

	function clearLikedSearch() {
		lSearchMode = false; lSearchQuery = ''; lSearchPage = 0; lSearchHasMore = true;
		likedListEl.innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted);">⏳</div>';
		fetch(`/LikedMovie/LoadMoreLikedMovies?pageIndex=0`)
			.then(r => r.text())
			.then(html => { likedListEl.innerHTML = html; })
			.catch(err => console.error('Liste yüklenemedi:', err));
	}

	// ── SCROLL: tab + mod'a göre doğru arama ──
	window.addEventListener('scroll', () => {
		const atBottom = (window.innerHeight + window.scrollY) >= document.body.offsetHeight - 200;
		if (!atBottom) return;

		const activeTab = getActiveTab();
		if (activeTab === 'history' && hSearchMode && hSearchHasMore) {
			loadHistorySearch(false);
		} else if (activeTab === 'liked' && lSearchMode && lSearchHasMore) {
			loadLikedSearch(false);
		} else if (activeTab === 'disliked' && dSearchMode && dSearchHasMore) {
			loadDislikedSearch(false);
		}
	});

	// ── BEĞENİLMEYENLER ARAMA ──
	async function startDislikedSearch(query) {
		dSearchQuery = query;
		dSearchPage = 0;
		dSearchHasMore = true;
		dSearchMode = true;

		dislikedListEl.innerHTML = '<div style="text-align:center;padding:40px;color:var(--muted);font-size:13px;">⏳ Aranıyor...</div>';
		await loadDislikedSearch(true);
	}

