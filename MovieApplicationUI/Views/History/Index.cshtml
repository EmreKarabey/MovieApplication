							<div style="font-size:16px;font-weight:600;color:var(--text);">Sonuç bulunamadı</div>
							<div style="font-size:13px;margin-top:6px;">"${dSearchQuery}" için beğenilmeyenlerinizde film yok.</div>
						</div>`;
					dSearchHasMore = false; return;
				}
				dislikedListEl.innerHTML = html;
			} else {
				if (html.trim().length === 0) { dSearchHasMore = false; return; }
				dislikedListEl.insertAdjacentHTML('beforeend', html);
			}

			const cardCount = (html.match(/history-card/g) || []).length;
			if (cardCount < 10) dSearchHasMore = false;
			dSearchPage++;

		} catch (err) {
			console.error('Arama hatası:', err);
			showToast('Arama sırasında hata oluştu.', 'info');
		}
	}

	function clearDislikedSearch() {
		dSearchMode = false; dSearchQuery = ''; dSearchPage = 0; dSearchHasMore = true;
		dislikedListEl.innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted);">⏳</div>';
		fetch(`/UnlikedMovie/LoadMoreUnlikedMovies?pageIndex=0`)
			.then(r => r.text())
			.then(html => { dislikedListEl.innerHTML = html; })
			.catch(err => console.error('Liste yüklenemedi:', err));
	}
</script>
