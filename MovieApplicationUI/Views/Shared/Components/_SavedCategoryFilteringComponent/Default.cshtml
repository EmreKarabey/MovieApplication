@model List< GetCatgoryFiltreDto>


<div class="movie-grid">
    @if (!Model.Any())
    {
        <div class="empty">
            <div class="empty-icon">🔖</div>
            <div class="empty-title">Henüz film kaydetmedin</div>
            <div class="empty-desc">Beğendiğin filmleri kaydet, burada listele.</div>
        </div>
    }
    else
    {
        @foreach (var movie in Model)
        {
            <div class="movie-card">
                <div class="card-poster-wrap">
                    <img class="card-poster" src="@movie.ImageURL" alt="@movie.Name" />
                    <div class="card-rating">★ </div>
                    <div class="card-overlay">
                        <button class="play-btn">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>
                        </button>
                        <div class="overlay-actions">
                            <button class="ov-btn favorite-btn" id="favorite-btn_@movie.EntityID" data-movie-id="@movie.EntityID" onclick="toggleFavoriteMovie('@movie.EntityID')">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                            </button>
                            <button class="ov-btn save-btn" id="saveBtn_@movie.EntityID" data-movie-id="@movie.EntityID" onclick="toggleSaveMovie('@movie.EntityID')"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="pointer-events: none;"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg></button>
                            <button class="ov-btn info-btn" onclick="openMovieDetails('@movie.EntityID')">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-title">@movie.Name</div>
                <div class="card-info">
                    <span>@movie.ReleaseDate</span>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    checkIfSaved('@movie.EntityID');
                    checkIfFavorite('@movie.EntityID');
                });
            </script>
        }
    }
</div>