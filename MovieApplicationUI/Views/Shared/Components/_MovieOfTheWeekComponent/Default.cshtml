@model MovieCategoryDetail

<div class="hero-bg"></div>
<div class="hero-gradient"></div>
<div class="hero-gradient-bottom"></div>

<!-- Film arka plan resmi -->
<div style="position:absolute;inset:0;
            background-image:url('@Model.ImageURL');
            background-size:cover;
            background-position:center;
            opacity:0.25;
            filter:saturate(0.5);">
</div>

<div class="hero-content">
    <div class="hero-badge">🔴 Haftanın Filmi</div>
    <div class="hero-title">@Model.Name</div>
    <div class="hero-meta">
        <div class="hero-rating">8.4 <span>/ 10</span></div>
        <div class="meta-pill">@Model.ReleaseDate</div>
        <div class="meta-pill">148 dk</div>
        <div class="meta-pill">@string.Join(", ", Model.CategoryName)</div>
        <div class="meta-pill">HD</div>
    </div>
    <div class="hero-desc">@Model.Description.Substring(0, (int)Math.Ceiling(Model.Description.Count() / 2.0)) ...</div>
    <div class="hero-actions">
        <a href="/Movie/Play?videoUrl=@Model.VideoURL&MovieID=@Model.MovieId&movieName=@Model.MovieName" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg> Şimdi İzle
        </a>
        <button class="btn-ghost save-btn" id="heroSaveBtn_@Model.EntityId" data-movie-id="@Model.EntityId" onclick="toggleSaveMovie('@Model.EntityId')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg> Kaydet
        </button>
        <button class="btn-ghost info-btn" onclick="openMovieDetails('@Model.MovieId')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg> Detaylar
        </button>
    </div>
</div>

<div class="hero-thumbs">
    <div class="hero-thumb active" style="background-image:url('@Model.ImageURL');background-size:cover;"></div>
</div>


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            checkIfSaved('@Model.EntityId');
        });
    </script>