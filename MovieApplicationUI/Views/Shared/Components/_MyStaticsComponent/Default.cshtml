@model MyStaticsMovieDto

<div class="profile-stats">
    <div class="stat-card">
        <div class="stat-value">@Model.WatchMovieCount</div>
        <div class="stat-label">İzlenen Film</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">@Model.FavoriteMovieCount</div>
        <div class="stat-label">Favoriler</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">@Model.SaveMovieCount</div>
        <div class="stat-label">Kaydedilmişler</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">@Model.MovieHoursCount</div>
        <div class="stat-label">İzleme Saati</div>
    </div>
</div>