@{
    var currentPath = Context.Request.Path.Value ?? "";
    var a = ViewBag.Name?.ToString()?.Substring(0,1);
}

<aside class="sidebar">
    <div class="logo" style="display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div class="logo-text">MovieApp</div>
        </div>
        <button type="button" class="sidebar-mobile-close" onclick="closeMobileSidebar()" aria-label="Menüyü Kapat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
    </div>

    <div class="user-section">
        <div class="avatar">@a</div>
        <div class="user-info">
            <div class="user-name">@ViewBag.Name</div>
        </div>
    </div>


    <div class="nav-section">
        <div class="nav-label">Keşfet</div>
        <a class="nav-item @(currentPath == "/" || currentPath.StartsWith("/Home") ? "active" : "")" href="/Home/Index">
            <span class="nav-icon" style="color:#7eb8da"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span> Ana Sayfa
        </a>
        <a class="nav-item @(currentPath.StartsWith("/Forum") ? "active" : "")" href="/Forum/Index">
            <span class="nav-icon" style="color:#f5b041"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span> Forum
        </a>

    </div>

    <div class="nav-section">
        <div class="nav-label">Kütüphanem</div>
        <a class="nav-item @(currentPath.StartsWith("/FavoriteMovie") ? "active" : "")" href="/FavoriteMovie/Index">
            <span class="nav-icon" style="color:#e06b6b"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span> Favorilediklerim
        </a>
        <a class="nav-item @(currentPath.StartsWith("/SavedMovie") ? "active" : "")" href="/SavedMovie/Index">
            <span class="nav-icon" style="color:#e8b84b"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></span> Kaydedilenler
        </a>
        <a class="nav-item @(currentPath.StartsWith("/History") ? "active" : "")" href="/History/Index">
            <span class="nav-icon" style="color:#6bb8c9"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span> Geçmiş
        </a>
    </div>

    <div class="nav-section">
        <div class="nav-label">Hesap</div>
        <a class="nav-item @(currentPath.StartsWith("/Profile") ? "active" : "")" href="/Profile/Index">
            <span class="nav-icon" style="color:#7ea8da"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span> Profil
        </a>
        <a class="nav-item @(currentPath.StartsWith("/Settings") ? "active" : "")" href="/Settings/Index">
            <span class="nav-icon" style="color:#9a9ab0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span> Ayarlar
        </a>
        <a class="nav-item" href="/Login/Logout">
            <span class="nav-icon" style="color:#c97a7a"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></span> Çıkış
        </a>
    </div>






</aside>