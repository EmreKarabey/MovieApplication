	<script>
		function openMovieDetails(id) {
			const modal = document.getElementById('movieDetailsModal');
			const contentDiv = document.getElementById('movieDetailsModalContent');

			contentDiv.innerHTML = "<p style='color:white; padding:20px;'>Yükleniyor...</p>";
			if (modal) {
				modal.classList.add('active');
				document.body.style.overflow = 'hidden';
			}

			fetch(`/Movie/GetMovieDetailsModal/${id}`)
				.then(response => {
					if (!response.ok) {
						throw new Error("Sunucu Hatası: " + response.status);
					}
					return response.text();
				})
				.then(html => {
					contentDiv.innerHTML = html;
				})
				.catch(error => {
					contentDiv.innerHTML = `<p style='color:red; padding:20px;'>Hata oluştu: ${error.message} <br><br> Muhtemelen Controller veya Component henüz hazır değil.</p>`;
				});
		}

		function closeMovieDetails() {
			const modal = document.getElementById('movieDetailsModal');
			if (modal) {
				modal.classList.remove('active');
				document.body.style.overflow = '';
			}
		}

		function setNav(el) {
		  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
		  el.classList.add('active');
		}


		async function setTab(el) {
			const category = el.textContent.trim();


			const allTabs = el.parentElement.querySelectorAll('.category-btn, .tab-btn, button');
			allTabs.forEach(n => n.classList.remove('active'));
			el.classList.add('active');

			if (typeof currentPage !== 'undefined') {
				currentPage = 0;
				hasMore = true;
				categoryName = category === "Tümü" ? "" : category;
			}

			let url = "";
			if (typeof window.getMoviesUrl === 'function') {
				url = window.getMoviesUrl(categoryName, 0);
			} else {
				url = category === "Tümü"
					? `/Home/LoadMoreMovies?pageIndex=0`
					: `/Home/LoadMoreMovies?categoryName=${encodeURIComponent(category)}&pageIndex=0`;
			}

			const loadingIndicator = document.getElementById('loadingIndicator');
			if(loadingIndicator) loadingIndicator.style.display = 'block';

			const currentContainer = document.querySelector('.movie-grid');
			if (currentContainer) {
				currentContainer.innerHTML = '';
			}

			try {
				const response = await fetch(url);
				if (!response.ok) throw new Error("API hatası");

				const html = await response.text();

				const parser = new DOMParser();
				const doc = parser.parseFromString(html, 'text/html');
				const newContainer = doc.querySelector('.movie-grid');

				if (currentContainer && newContainer) {
					currentContainer.innerHTML = newContainer.innerHTML;

					const scripts = currentContainer.querySelectorAll('script');
					scripts.forEach(script => {
						try {
							eval(script.innerText);
						} catch(e) {
							console.error("Script error: ", e);
						}
					});
				}
			} catch (err) {
				console.error("Kategori yüklenirken hata: ", err);
			} finally {
				if(loadingIndicator) loadingIndicator.style.display = 'none';
			}
		}
		function setPage(el) {
		  document.querySelectorAll('.page-btn').forEach(b => b.classList.remove('active'));
		  el.classList.add('active');
		}
		function toggleTag(el) { el.classList.toggle('active'); }
		function rateStar(val) {
		  document.querySelectorAll('.star').forEach(s => {
			s.classList.toggle('active', parseInt(s.dataset.v) <= val);
		  });
		}

		window.addEventListener('click', function(e) {
			const modal = document.getElementById('movieDetailsModal');
			if (e.target === modal) {
				closeMovieDetails();
			}
		});

		window.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') {
				closeMovieDetails();
			}
		});

		function checkIfSaved(movieId) {
			fetch(`/SavedMovie/IsMovieSaved?movieId=${movieId}`, { cache: 'no-store' })
				.then(response => response.json())
				.then(isSaved => {
					const btns = document.querySelectorAll(`.save-btn[data-movie-id="${movieId}"]`);
					btns.forEach(btn => {
						if (isSaved === true) {
							btn.style.color = "#3b82f6";
							btn.dataset.saved = "true";
							if(btn.classList.contains('btn-ghost')) {
								btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg> Kaydedildi';
							}
						} else {
							btn.style.color = "#091616";
							btn.dataset.saved = "false";
							if(btn.classList.contains('btn-ghost')) {
								btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg> Kaydet';
								btn.style.color = "";
							}
						}
					});
				})
				.catch(err => console.log("Kontrol edilemedi", err));
		}

		function checkIfFavorite(movieId) {
			fetch(`/FavoriteMovie/IsMovieFavorite?movieId=${movieId}`, { cache: 'no-store' })
				.then(response => response.json())
				.then(isFavorite => {
					const btns = document.querySelectorAll(`.favorite-btn[data-movie-id="${movieId}"]`);
					btns.forEach(btn => {
						if (isFavorite === true) {
							btn.style.color = "#FF0033";
							btn.dataset.saved = "true";
						} else {
							btn.style.color = "#091616";
							btn.dataset.saved = "false";
						}
					});
				})
				.catch(err => console.log("Favori kontrol edilemedi", err));
		}

		function showToast(message, type = 'success') {
			const container = document.getElementById('toastContainer');
			if (!container) return;
			const toast = document.createElement('div');
			toast.className = `toast ${type}`;
			toast.innerText = message;

			container.appendChild(toast);

			setTimeout(() => {
				toast.classList.add('show');
			}, 10);

			setTimeout(() => {
				toast.classList.remove('show');
				setTimeout(() => {
					toast.remove();
				}, 300);
			}, 3000);
		}

		function toggleSaveMovie(movieId) {
			const btns = document.querySelectorAll(`.save-btn[data-movie-id="${movieId}"]`);
			if (btns.length === 0) return;
			const isCurrentlySaved = btns[0].dataset.saved === "true";

			if (isCurrentlySaved) {
				fetch(`/SavedMovie/RemoveSavedMovie?movieId=${movieId}`, { method: 'POST' })
					.then(response => {
						if(response.ok) {
							btns.forEach(btn => {
								btn.style.color = "#091616";
								btn.dataset.saved = "false";
								if(btn.classList.contains('btn-ghost')) {
									btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg> Kaydet';
									btn.style.color = "";
								}
							});
							showToast("Film kaydedilenlerden çıkarıldı.", "info");
						}
					});
			} else {
				fetch(`/SavedMovie/AddSavedMovie?MovieId=${movieId}`, { method: 'POST' })
					.then(response => {
						if(response.ok) {
							btns.forEach(btn => {
								btn.style.color = "#3b82f6";
								btn.dataset.saved = "true";
								if(btn.classList.contains('btn-ghost')) {
									btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg> Kaydedildi';
								}
							});
							showToast("Film başarıyla kaydedildi!", "success");
						}
					});
			}
		}


		function toggleFavoriteMovie(movieId) {
			const btns = document.querySelectorAll(`.favorite-btn[data-movie-id="${movieId}"]`);
			if (btns.length === 0) return;
			const isCurrentlySaved = btns[0].dataset.saved === "true";
			console.log(`toggleFavoriteMovie called for ${movieId}, isCurrentlySaved: ${isCurrentlySaved}`);

			if (isCurrentlySaved) {
				fetch(`/FavoriteMovie/RemoveFavoriteMovie?movieId=${movieId}`, { method: 'POST' })
					.then(response => {
						console.log("Remove response ok:", response.ok);
						if(response.ok) {
							btns.forEach(btn => {
								btn.style.color = "#091616";
								btn.dataset.saved = "false";
							});
							showToast("Film favorilerden çıkarıldı.", "info");
						} else {
							response.text().then(text => console.error("Remove failed with status", response.status, "Details:", text));
						}
					})
					.catch(err => console.error("Remove fetch error:", err));
			} else {
				fetch(`/FavoriteMovie/AddFavoriteMovie?MovieId=${movieId}`, { method: 'POST' })
					.then(response => {
						console.log("Add response ok:", response.ok);
						if(response.ok) {
							btns.forEach(btn => {
								btn.style.color = "#FF0033";
								btn.dataset.saved = "true";
							});
							showToast("Film başarıyla favorilere kaydedildi!", "success");
						} else {
							console.error("Add failed with status", response.status);
						}
					})
					.catch(err => console.error("Add fetch error:", err));
			}
		}





		// ── DARK MODE TOGGLE ──
		async function toggleDarkMode() {
			const isLight = document.body.classList.contains('light-mode');
			const btn = document.getElementById('darkModeBtn');

			if (btn) {
				btn.style.opacity = '0.5';
				btn.style.pointerEvents = 'none';
			}

			try {
				if (isLight) {
					// Light -> Dark: Karanlık modu aktif et
					const response = await fetch('/Settings/ActiveDarkMode', { method: 'POST' });
					const data = await response.json();
					if (data.isSuccess) {
						document.body.classList.remove('light-mode');
						if (btn) btn.innerHTML = '<span class="dm-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg></span>';
						showToast('Karanlık mod aktif!', 'success');
					} else {
						showToast(data.message || 'Bir hata oluştu.', 'info');
					}
				} else {
					// Dark -> Light: Karanlık modu kapat
					const response = await fetch('/Settings/DisableDarkMode', { method: 'POST' });
					const data = await response.json();
					if (data.isSuccess) {
						document.body.classList.add('light-mode');
						if (btn) btn.innerHTML = '<span class="dm-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg></span>';
						showToast('Aydınlık mod aktif!', 'success');
					} else {
						showToast(data.message || 'Bir hata oluştu.', 'info');
					}
				}
			} catch (err) {
				showToast('Sunucuya ulaşılamadı.', 'info');
				console.error('Dark mode toggle error:', err);
			} finally {
				if (btn) {
					btn.style.opacity = '1';
					btn.style.pointerEvents = 'auto';
				}
			}
		}

		// Sayfa yüklenince dark mode durumunu kontrol et
		document.addEventListener('DOMContentLoaded', async function () {
			try {
				const response = await fetch('/Settings/IsDarkMode');
				const data = await response.json();
				const btn = document.getElementById('darkModeBtn');

				if (data.isSuccess === true) {
					// Dark mode AÇIK -> Normal (dark) görünüm
					document.body.classList.remove('light-mode');
					if (btn) btn.innerHTML = '<span class="dm-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg></span>';
				} else {
					// Dark mode KAPALI -> Light görünüm
					document.body.classList.add('light-mode');
					if (btn) btn.innerHTML = '<span class="dm-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg></span>';
				}
			} catch (err) {
				console.warn('Dark mode durumu alınamadı, varsayılan karanlık mod kullanılıyor.');
			}
		});

		function toggleMobileSidebar() {
			if (document.body.classList.contains('cinema-mode')) {
				document.body.classList.toggle('sidebar-open');
			} else if (window.innerWidth <= 992) {
				document.body.classList.toggle('sidebar-open');
			} else {
				document.body.classList.toggle('sidebar-closed');
				const isClosed = document.body.classList.contains('sidebar-closed');
				localStorage.setItem('sidebarState', isClosed ? 'closed' : 'open');
			}
		}

		function closeMobileSidebar() {
			document.body.classList.remove('sidebar-open');
		}

		document.addEventListener('DOMContentLoaded', function() {
			if (!document.body.classList.contains('cinema-mode') && window.innerWidth > 992 && localStorage.getItem('sidebarState') === 'closed') {
				document.body.classList.add('sidebar-closed');
			}

			let topbars = document.querySelectorAll('.topbar');
			if (topbars.length === 0) {
				const main = document.querySelector('main.main');
				if (main) {
					const fallbackTb = document.createElement('div');
					fallbackTb.className = 'topbar fallback-mobile-topbar';
					fallbackTb.style.display = 'flex';
					fallbackTb.style.alignItems = 'center';
					fallbackTb.style.justifyContent = 'space-between';
					fallbackTb.style.padding = '10px 16px';
					fallbackTb.style.borderBottom = '1px solid var(--border)';
					
					const actions = document.createElement('div');
					actions.className = 'topbar-actions';
					actions.innerHTML = '<div class="icon-btn" id="notifBell"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg><div class="notif-dot" style="display:none;"></div></div><div class="icon-btn dark-mode-btn" onclick="toggleDarkMode()" title="Karanlık/Aydınlık mod"><span class="dm-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg></span></div>';

					fallbackTb.appendChild(actions);
					main.insertBefore(fallbackTb, main.firstChild);
					topbars = document.querySelectorAll('.topbar');
				}
			}

			topbars.forEach(tb => {
				if (tb.querySelector('.sidebar-toggle-btn')) return;
				const toggleBtn = document.createElement('button');
				toggleBtn.className = 'icon-btn sidebar-toggle-btn';
				toggleBtn.style.marginRight = '10px';
				toggleBtn.style.background = 'transparent';
				toggleBtn.style.border = 'none';
				toggleBtn.style.color = 'var(--text)';
				toggleBtn.style.cursor = 'pointer';
				toggleBtn.style.flexShrink = '0';
				toggleBtn.setAttribute('aria-label', 'Menüyü Aç/Kapat');
				toggleBtn.innerHTML = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>';

				toggleBtn.addEventListener('click', toggleMobileSidebar);
				tb.insertBefore(toggleBtn, tb.firstChild);
			});

			// Mobil menüdeki linklere tıklanınca menüyü kapat
			document.querySelectorAll('.sidebar .nav-item').forEach(item => {
				item.addEventListener('click', () => {
					if (window.innerWidth <= 992) {
						closeMobileSidebar();
					}
				});
			});
		});

	</script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
	<script>
		var notificationConnection = new signalR.HubConnectionBuilder()
			.withUrl("https://localhost:7021/signalrHub")
			.build();

		notificationConnection.start().then(function() {
			var userId = "@ViewBag.UserID";
			if (userId) {
				notificationConnection.invoke("JoinNotificationGroup", userId);
			}
		});

		var _lastNotifCount = -1;

		notificationConnection.on("NotificationList", function(notifications) {
			if (notifications && notifications.length > 0) {
				var latest = notifications[0];
				showNotificationPopup(latest.message, latest.url);
			}
		});

		notificationConnection.on("ReceiveNotificationCount", function(count) {
			document.querySelectorAll(".notif-dot").forEach(dot => {
				dot.innerText = count;
				if (count > 0) {
					dot.style.display = "flex";
				} else {
					dot.style.display = "none";
				}
			});

			// Yeni bildirim geldi mi kontrol et
			if (_lastNotifCount >= 0 && count > _lastNotifCount) {
				// Zil ikonunu salla
				document.querySelectorAll('#notifBell').forEach(function(bell) {
					bell.classList.add('bell-shake');
					setTimeout(function() { bell.classList.remove('bell-shake'); }, 1000);
				});
			}
			_lastNotifCount = count;
		});

		function showNotificationPopup(message, url) {
			var container = document.getElementById('notifPopupContainer');
			if (!container) return;

			var popup = document.createElement('div');
			popup.className = 'notif-popup';
			popup.innerHTML = '<div class="notif-popup-inner">' +
				'<div class="notif-popup-bell">🔔</div>' +
				'<div class="notif-popup-body">' +
					'<div class="notif-popup-title">Yeni Bildirim</div>' +
					'<div class="notif-popup-msg">' + message + '</div>' +
					'<div class="notif-popup-hint">Görüntülemek için tıklayın</div>' +
				'</div>' +
				'<button class="notif-popup-close" onclick="closeNotifPopup(event, this)">&times;</button>' +
			'</div>' +
			'<div class="notif-popup-progress"></div>';

			// Tıklayınca URL'ye git
			popup.addEventListener('click', function(e) {
				if (e.target.closest('.notif-popup-close')) return;
				if (url && url !== '#') {
					window.location.href = url;
				} else {
					// Bildirim panelini aç
					var panel = document.getElementById('notifPanel');
					if (panel) {
						panel.classList.add('open');
						loadNotifications();
					}
					closeNotifPopup(e, popup.querySelector('.notif-popup-close'));
				}
			});

			container.appendChild(popup);

			// 5 saniye sonra otomatik kapat
			setTimeout(function() {
				if (popup.parentNode) {
					popup.classList.add('closing');
					setTimeout(function() { popup.remove(); }, 400);
				}
			}, 5000);
		}

		function closeNotifPopup(event, btn) {
			event.preventDefault();
			event.stopPropagation();
			var popup = btn.closest('.notif-popup');
			if (popup) {
				popup.classList.add('closing');
				setTimeout(function() { popup.remove(); }, 400);
			}
		}


		function loadNotifications() {
			var notifBody = document.getElementById("notifBody");
			if (!notifBody) return;
			notifBody.innerHTML = '<div class="notif-empty"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg><p>Yükleniyor...</p></div>';

			fetch('/Notification/GetNotificationsJson')
				.then(r => r.json())
				.then(res => {
					if (!res.success || !res.data || res.data.length === 0) {
						notifBody.innerHTML = '<div class="notif-empty"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg><p>Bildirim bulunmuyor</p></div>';
						return;
					}
					var html = '';
					res.data.forEach(function(n, index) {
						var cls = n.isRead ? 'notif-item' : 'notif-item unread';
						var url = n.url ? n.url : '#';
						var entityId = n.entityID || '';
						html += '<div class="' + cls + '" data-notif-id="' + entityId + '" data-notif-url="' + url + '" onclick="readAndNavigate(this)" style="animation-delay:' + (index * 0.05) + 's">';
						html += '<div class="notif-icon-wrapper"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg></div>';
						html += '<div class="notif-content"><div class="notif-msg">' + n.message + '</div></div>';
						html += '<button class="notif-delete-btn" onclick="deleteNotification(event, this)" title="Bildirimi sil"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg></button>';
						html += '</div>';
					});
					notifBody.innerHTML = html;
				})
				.catch(() => {
					notifBody.innerHTML = '<div class="notif-empty"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg><p>Bir hata oluştu</p></div>';
				});
		}

		function readAndNavigate(el) {
			var notifId = el.getAttribute('data-notif-id');
			var url = el.getAttribute('data-notif-url') || '#';

			// Okundu olarak işaretle (PATCH)
			if (notifId) {
				fetch('/Notification/Read', {
					method: 'PATCH',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(notifId)
				}).then(function() {
					// Unread class'ını kaldır
					el.classList.remove('unread');
					updateNotificationCount();
				}).catch(function(err) {
					console.error('Okundu işaretleme hatası:', err);
				});
			}

			// Videoya yönlendir
			if (url && url !== '#') {
				window.location.href = url;
			}
		}

		function deleteNotification(event, btn) {
			event.preventDefault();
			event.stopPropagation();

			var notifItem = btn.closest('.notif-item');
			var notifId = notifItem ? notifItem.getAttribute('data-notif-id') : null;

			// Silme animasyonu başlat
			notifItem.classList.add('removing');

			// API'ye silme isteği at
			if (notifId) {
				fetch('/Notification/RemoveNotification', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(notifId)
				}).then(function(res) {
					if (res.ok) {
						updateNotificationCount();
					} else {
						console.error('Bildirim silme başarısız:', res.status);
					}
				}).catch(function(err) {
					console.error('Bildirim silme hatası:', err);
				});
			}

			// Animasyon bittikten sonra DOM'dan kaldır
			setTimeout(function() {
				notifItem.remove();

				// Eğer hiç bildirim kalmadıysa boş mesaj göster
				var notifBody = document.getElementById("notifBody");
				if (notifBody && notifBody.querySelectorAll('.notif-item').length === 0) {
					notifBody.innerHTML = '<div class="notif-empty"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg><p>Bildirim bulunmuyor</p></div>';
				}
			}, 350);
		}

		function updateNotificationCount() {
			fetch('/Notification/GetNotificationsJson')
				.then(function(r) { return r.json(); })
				.then(function(res) {
					if (res.success && res.data) {
						var unreadCount = res.data.filter(function(n) { return !n.isRead; }).length;
						document.querySelectorAll('.notif-dot').forEach(function(dot) {
							dot.innerText = unreadCount;
							dot.style.display = unreadCount > 0 ? 'flex' : 'none';
						});
					}
				}).catch(function() {});
		}

		document.addEventListener("click", function(e) {
			const notifPanel = document.getElementById("notifPanel");
			if (!notifPanel) return;

			const bellBtn = e.target.closest('#notifBell');
			if (bellBtn) {
				e.preventDefault();
				e.stopPropagation();
				var isOpen = notifPanel.classList.toggle("open");
				if (isOpen) loadNotifications();
				return;
			}

			if (!e.target.closest('.notif-panel')) {
				notifPanel.classList.remove("open");
			}
		});

		// Sayfa yüklendiğinde bildirim sayısını çek
		document.addEventListener("DOMContentLoaded", function() {
			fetch('/Notification/GetNotificationsJson')
				.then(r => r.json())
				.then(res => {
					if (res.success && res.data) {
						var unreadCount = res.data.filter(n => !n.isRead).length;
						document.querySelectorAll(".notif-dot").forEach(dot => {
							dot.innerText = unreadCount;
							dot.style.display = unreadCount > 0 ? "flex" : "none";
						});
					}
				})
				.catch(() => {});
		});
	</script>
</head>
