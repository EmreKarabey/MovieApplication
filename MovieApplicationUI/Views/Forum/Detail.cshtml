@model GetForumDetailsDto

@{
	ViewData["Title"] = "Forum Detay";
}

@{
	var timeAgo = DateTime.UtcNow - Model.CreatedAt;

	string time;

	if (timeAgo.TotalMinutes < 0)
	{
		time = "Şimdi";
	}
	else if (timeAgo.TotalMinutes < 60)
	{
		time = $"{timeAgo.TotalMinutes} dakika önce";
	}
	else if (timeAgo.TotalHours < 24)
	{
		time = $"{(int)timeAgo.TotalHours} saat önce";
	}

	else if (timeAgo.TotalDays < 7)
	{
		time = $"{(int)timeAgo.TotalDays} gün önce";
	}
	else
	{
		time = Model.CreatedAt.ToString("dd MMMM yyyy");
	}
}

<style>
	.forum-detail-container {
		padding: 20px;
		color: #e4e4e6;
		font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
	}

	.topic-header {
		margin-bottom: 25px;
		padding-bottom: 15px;
		border-bottom: 1px solid #2a2a2a;
	}

		.topic-header h1 {
			font-size: 24px;
			color: #f5b041;
			margin: 0 0 10px 0;
			font-weight: 600;
		}

	.topic-meta {
		font-size: 13px;
		color: #888;
		display: flex;
		gap: 15px;
	}

		.topic-meta span {
			display: flex;
			align-items: center;
			gap: 5px;
		}

	.post-card {
		display: flex;
		background-color: #1a1a1a;
		border: 1px solid #2a2a2a;
		border-radius: 8px;
		margin-bottom: 20px;
		overflow: hidden;
	}

	.post-user-col {
		width: 180px;
		background-color: #202020;
		padding: 20px 15px;
		text-align: center;
		border-right: 1px solid #2a2a2a;
		flex-shrink: 0;
	}

	.post-avatar {
		width: 60px;
		height: 60px;
		background-color: #f5b041;
		color: #1a1a1a;
		border-radius: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		font-size: 24px;
		font-weight: bold;
		margin: 0 auto 15px auto;
	}

	.post-username {
		color: #f5b041;
		font-weight: 600;
		font-size: 15px;
		margin-bottom: 5px;
	}

	.post-usertitle {
		font-size: 12px;
		color: #aaa;
	}

	.post-content-col {
		flex: 1;
		padding: 20px;
		display: flex;
		flex-direction: column;
	}

	.post-meta {
		font-size: 12px;
		color: #777;
		margin-bottom: 15px;
		padding-bottom: 10px;
		border-bottom: 1px solid #2a2a2a;
		display: flex;
		justify-content: space-between;
	}

	.post-body {
		font-size: 15px;
		line-height: 1.6;
		color: #ddd;
		flex: 1;
	}

	.post-actions {
		margin-top: 20px;
		display: flex;
		justify-content: flex-end;
		gap: 10px;
	}

	.post-action-btn {
		background: transparent;
		border: 1px solid #333;
		color: #aaa;
		padding: 5px 10px;
		border-radius: 4px;
		font-size: 13px;
		cursor: pointer;
		transition: all 0.2s;
	}

		.post-action-btn:hover {
			background-color: #2a2a2a;
			color: #e4e4e6;
		}

	.reply-section {
		margin-top: 40px;
		background-color: #1a1a1a;
		border: 1px solid #2a2a2a;
		border-radius: 8px;
		padding: 20px;
	}

	.reply-header {
		font-size: 18px;
		color: #f5b041;
		margin-top: 0;
		margin-bottom: 15px;
		font-weight: 600;
	}

	.reply-textarea {
		width: 100%;
		background-color: #242424;
		border: 1px solid #333;
		border-radius: 4px;
		color: #e4e4e6;
		padding: 15px;
		font-family: inherit;
		font-size: 14px;
		min-height: 150px;
		resize: vertical;
		margin-bottom: 15px;
	}

		.reply-textarea:focus {
			outline: none;
			border-color: #f5b041;
		}

	.reply-btn {
		background-color: #f5b041;
		color: #1a1a1a;
		border: none;
		padding: 10px 20px;
		border-radius: 4px;
		font-weight: 600;
		cursor: pointer;
		font-size: 14px;
		transition: opacity 0.2s;
	}

		.reply-btn:hover {
			opacity: 0.9;
		}

	/* Responsive */
	@@media (max-width: 768px) {
		.forum-detail-container {
			padding: 14px 10px;
		}

		.topic-header h1 {
			font-size: 20px;
		}

		.topic-meta {
			flex-wrap: wrap;
			gap: 8px;
			font-size: 11px;
		}

		.post-card {
			flex-direction: column;
		}

		.post-user-col {
			width: 100%;
			border-right: none;
			border-bottom: 1px solid #2a2a2a;
			display: flex;
			align-items: center;
			padding: 10px 14px;
			text-align: left;
		}

		.post-avatar {
			width: 38px;
			height: 38px;
			font-size: 16px;
			margin: 0 12px 0 0;
		}

		.post-username {
			margin-bottom: 0;
			font-size: 14px;
		}

		.post-content-col {
			padding: 14px 12px;
		}

		.post-body {
			font-size: 14px;
		}

		.reply-section {
			padding: 16px 12px;
			margin-top: 24px;
		}

		.reply-header {
			font-size: 16px;
		}
	}
</style>

<div class="topbar">
	<a href="/Forum/Index" class="topbar-logo" style="text-decoration: none; display: flex; align-items: center; gap: 8px;">
		<span style="font-family: 'Bebas Neue', sans-serif; font-size: 26px; color: var(--accent, #e8b84b); letter-spacing: 1.5px; line-height: 1;">MovieApp</span>
		<span style="font-size: 10px; color: var(--muted); background: rgba(255,255,255,0.06); padding: 2px 6px; border-radius: 4px; font-weight: 600; letter-spacing: 0.5px;">FORUM</span>
	</a>
	<div class="topbar-actions" style="margin-left: auto;">
		<div class="icon-btn" id="notifBell">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
			<div class="notif-dot" style="display:none;"></div>
		</div>
		<div class="icon-btn dark-mode-btn" id="darkModeBtn" onclick="toggleDarkMode()" title="Karanlık/Aydınlık mod">
			<span class="dm-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg></span>
		</div>
	</div>
</div>

<div class="forum-detail-container">

	<div class="topic-header">
		<h1>@Model.Title</h1>
		<div class="topic-meta">
			<span>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
				@time
			</span>
			<span>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
				@Model.ForumCategorName
			</span>
		</div>
	</div>

	<!-- Konuyu Açan Mesaj -->
	<div class="post-card">
		<div class="post-user-col">
			<div class="post-avatar">@Model.UserName.Substring(0,1)</div>
			<div class="post-username">@Model.UserName</div>
			<div class="post-usertitle">Forum Sahibi</div>
		</div>
		<div class="post-content-col">
			<div class="post-meta">
				<span>@time @Model.CreatedAt.AddHours(3).ToShortTimeString()</span>
			</div>
			<div class="post-body">
			@Model.Details
			</div>
		</div>
	</div>

	<!-- Cevap Yazma Alanı -->
	<div class="reply-section">
		<h3 class="reply-header">Cevap Yaz</h3>
		<textarea class="reply-textarea" placeholder="Mesajınızı buraya yazın..."></textarea>
		<div>
			<button class="reply-btn">Cevabı Gönder</button>
		</div>
	</div>

</div>
