{
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB; Database=DBMovies; Trusted_Connection=true"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "CacheSettings": {
        "SlidingExpiration": 1
    },
    "SeriLogConfiguration": {
        "FileLogConfiguration": {
            "FilePath": "/logs/log"
        },
        "MsSqlLogConfiguration": {
            "ConnectionString": "Server=(localdb)\\MSSQLLocalDB; Database=DBMovies; Trusted_Connection=true",
            "TableName": "Logs",
            "AutoCreatedSqlTable": true
        }
    },
    "TokenOptions": {
        "Issuer": "movieApplication",
        "Audience": "movieApplication",
        "SecurityKey": "YOUR_JWT_SECRET_KEY_HERE",
        "AccessTokenExpiration": 60
    },

    "Smtp": {
        "Host": "smtp.gmail.com",
        "Port": 587,
        "EnableSsl": true,
        "User": "YOUR_SMTP_EMAIL_HERE",
        "Pass": "YOUR_SMTP_APP_PASSWORD_HERE"
    },

    "ToxicBert": {
        "Token": "YOUR_HUGGINGFACE_TOKEN_HERE",
        "Url": "https://router.huggingface.co/hf-inference/models/unitary/toxic-bert"
    },

    "Helsinki": {
        "Token": "YOUR_HUGGINGFACE_TOKEN_HERE",
        "URL": "https://router.huggingface.co/hf-inference/models/Helsinki-NLP/opus-mt-tr-en"
    },

    "Google": {
        "ClientID": "YOUR_GOOGLE_CLIENT_ID_HERE",
        "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET_HERE"
    },

    "AllowedHosts": "*"
}